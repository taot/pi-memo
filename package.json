{
  "name": "pi-mneme",
  "version": "0.1.0",
  "description": "Long-term memory extension for the pi coding agent: readable Markdown memories with BM25 recall",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "memory"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "files": ["src", "docs", "README.md"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "nodejieba": "^3.4.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "typebox": "^1.3.7",
    "vitest": "^3.0.0"
  }
}
